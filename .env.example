# 复制为 .env 后按需修改（compose.yaml 里已内置默认值）
JUSTNAV_PORT=8522
JUSTNAV_DATA_DIR=./data
JUSTNAV_SITE_NAME=JustNav

# ---- 壁纸：Bing 每日 UHD，免 key ----
JUSTNAV_WALLPAPER=true
JUSTNAV_WALLPAPER_KEEP_DAYS=30
# 300MB
JUSTNAV_WALLPAPER_MAX_BYTES=314572800

# ---- 状态探测 ----
JUSTNAV_PROBE=true
JUSTNAV_PROBE_INTERVAL_SEC=60
JUSTNAV_PROBE_TIMEOUT_SEC=4
# 连续失败几次才判离线。设 2 可压掉偶发超时造成的抖动；设 1 是「一次不通就报」
JUSTNAV_PROBE_THRESHOLD=2
# 内网自签证书放行（设为 false 会去校验证书，自签服务就会显示未响应）
JUSTNAV_PROBE_INSECURE=true

# ---- 登录认证 ----
# 可选。留空 → 首次启动自动创建 admin / admin（登录后请立刻改掉）
# 有值 → 用它作为首次初始化密码
# 已有账号后这个变量不再生效；改密码请到「设置 → 改密」，改账号名到「设置 → 改名」
# JUSTNAV_PASSWORD=change-me-to-something-long
JUSTNAV_USER=admin
# 走 HTTPS 反代时改成 true（cookie 加 Secure 标记）
JUSTNAV_COOKIE_SECURE=false

# ---- Docker 发现 ----
# 直挂宿主机的 docker socket，程序会自动发现 /var/run/docker.sock，不配也行：
# JUSTNAV_DOCKER_HOST=unix:///var/run/docker.sock
#
# ⚠️ 安全提示：挂 socket 等于把宿主机的 Docker 控制权交给容器 ——
#    容器里能做的事基本等同宿主机 root。本项目定位是「本机 / 内网自用」，
#    所以默认就这么直挂，简单直接，不用额外起容器。
#
#    如果你打算把它暴露到公网，或者对这一点不放心，可以自行换成只读的
#    旁车代理（docker-socket-proxy，只放行 /containers 的 GET 请求），
#    然后把下面这行改成 tcp://docker-proxy:2375：
JUSTNAV_DOCKER_HOST=unix:///var/run/docker.sock
#
# true = 没打 nav.* 标签、但有端口映射的容器也进「待收录」候选，
#        在界面上勾一下就能加进来 —— 这是「开箱即用」的关键
# false = 只认打了标签的容器
JUSTNAV_DOCKER_SCAN_ALL=true
